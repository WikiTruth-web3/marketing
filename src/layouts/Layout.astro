---
import '@/styles/index.css';

interface Props {
	title?: string;
  description?: string;
  lang?: string;
}

const { 
  title = "Wiki Truth | Anonymous Whistleblowing, Privacy & Evidence Rewards",
  description = "Report crime anonymously and reduce identity risk. Wiki Truth is a decentralized truth market on Oasis Sapphire: mint sensitive leads as Truth Boxes, trade criminal evidence, delayed-disclosure economics that make cover-ups costly, and sustainable on-chain rewards for whistleblowers.",
  lang = "en"
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <!-- LOGO -->
    <link rel="icon" type="image/svg+xml" href="/logo/logo-black.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="whistleblower rewards, anonymous reporting, crime reporting privacy, Oasis Sapphire, Truth Box, decentralized truth market, evidence marketplace, delayed disclosure, whistleblower protection, 匿名举报,举报人保护,悬赏证据,真相市场,익명 제보,범죄 신고,내부고발자 보호,제보 보상,匿名通報,内部告発,告発者保護,通報報奨金,Anonyme Hinweise,Whistleblower-Schutz,Hinweisprämie,denuncia anónima,protección del denunciante,recompensa por evidencias,denúncia anônima,proteção ao denunciante,recompensa por denúncias"
    />
    <link rel="canonical" href="https://wikitruth.xyz/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://wikitruth.xyz/" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Decentralized whistleblower incentives and criminal-evidence marketplace on Oasis Sapphire. Anonymous Truth Boxes, delayed-disclosure economics, and privacy-preserving paths for justice."
    />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta property="og:locale:alternate" content="ko_KR" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@WikiTruthLabs" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content="Anonymous reporting with privacy protection and reward mechanisms on Oasis Sapphire. Truth Boxes, delayed disclosure, whistleblower incentives."
    />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://wikitruth.xyz/#website",
            "name": "Wiki Truth",
            "alternateName": ["Wiki Truth", "真相市场", "维基真相", "위키 트루스", "ウィキ・トゥルース", "Whistleblower-web3", "Wikileaks web3"],
            "url": "https://wikitruth.xyz/",
            "inLanguage": ["en", "zh-CN", "ko-KR", "ja-JP", "de-DE", "es-ES", "pt-BR", "pt-PT"],
            "description": "Decentralized whistleblower incentives and criminal-evidence marketplace on Oasis Sapphire. Users can anonymously mint sensitive evidence as Truth Boxes, trade them, and benefit from delayed-disclosure economics with sustainable anonymous rewards."
          },
          {
            "@type": "SoftwareApplication",
            "name": "Wiki Truth",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "Web",
            "url": "https://wikitruth.xyz/"
          }
        ]
      }
    </script>
  </head>
  <body>
    <div class="flex flex-col w-full mx-auto">
      <slot />
    </div>
  </body>
</html>
